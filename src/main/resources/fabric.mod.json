{
	"schemaVersion": 1,
	"id": "frog_petting",
	"version": "${version}",
	"name": "Pet Frogs and More!",
	"description": "A mod that lets you squish and pet all the animals you could want!",
	"authors": [
		"Trinketina"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/frog-petting/",
		"sources": "https://github.com/Trinketina/Frog-Petting/"
	},
	"icon": "assets/frog_petting/icon.png",
	"environment": "*",
	"entrypoints": {
		"fabric-datagen": [
			"net.trinketina.frogpetting.PettingDataGen"
		],
		"main": [
			"net.trinketina.frogpetting.PettingMain"
		],
		"client": [
          "net.trinketina.frogpetting.PettingClient"
		]
	},
	"mixins": [
      "frog-petting.mixins.json",
      {
        "config": "frog-petting.client.mixins.json",
        "environment": "client"
      }
	],
	"depends": {
		"fabricloader": ">=0.17.2",
        "fabric-api": "*",
		"minecraft": ">=26.1",
		"java": ">=21"
	}
}